# Plausible Analytics — self-hosted config
# Скопируйте в .env.plausible и заполните (или сгенерируйте секреты командами ниже)

# 1. Секрет для подписи сессий (64 hex chars)
# Сгенерировать: openssl rand -hex 32
SECRET_KEY=changeme_64_hex_chars_here

# 2. Пароль БД TimescaleDB (32 hex chars)
# Сгенерировать: openssl rand -hex 16
PLAUSIBLE_DB_PASSWORD=changeme_32_hex_chars_here

# 3. URL экземпляра Plausible (публичный, с https)
BASE_URL=https://plausibl.duckdns.org

# 4. Отключить регистрацию новых пользователей (только админ создаёт аккаунты)
DISABLE_REGISTRATION=true

# 5. Настройки почты (опционально — для инвайтов/сброса пароля)
# MAIL_FROM=analytics@yourdomain.com
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASSWORD=your_smtp_password
# SMTP_TLS=true

# 6. Дополнительно (обычно не менять)
# MAXMIND_LICENSE_KEY=           # для гео-определения (нужен аккаунт MaxMind)
# GEOIP_UPDATE_FREQUENCY=0       # 0 = не обновлять
# DISABLE_IP_PERSISTENCE=true    # не хранить IP (ещё больше приватности)